{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Woodshed capability cutover artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifactVersion", "capability", "owner", "approver", "release", "baseline", "recovery", "deploy", "observations", "rollback", "observability", "approvals"],
  "properties": {
    "artifactVersion": { "const": 1 },
    "capability": { "enum": ["event", "ballot", "assignment", "live"] },
    "owner": { "type": "string", "minLength": 1 },
    "approver": { "type": "string", "minLength": 1 },
    "release": { "$ref": "#/$defs/release" },
    "baseline": { "type": "object", "additionalProperties": false, "required": ["queries", "resultFingerprint"], "properties": { "queries": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "resultFingerprint": { "$ref": "#/$defs/hash" } } },
    "recovery": { "type": "object", "additionalProperties": false, "required": ["backupId", "restoreProofId", "strategy"], "properties": { "backupId": { "type": "string", "minLength": 1 }, "restoreProofId": { "type": "string", "minLength": 1 }, "strategy": { "enum": ["journal-replay", "freeze-snapshot-cutback", "irreversible-forward-fix"] }, "journalStart": { "type": "string" } } },
    "deploy": { "type": "object", "additionalProperties": false, "required": ["order", "routingFlag", "immutableOrigin", "immutableOriginVerified", "alias", "aliasChangedAfterOriginVerification", "pinnedCli"], "properties": { "order": { "const": ["schema-expand", "reader", "writer", "route"] }, "routingFlag": { "type": "string" }, "immutableOrigin": { "type": "string" }, "immutableOriginVerified": { "const": true }, "alias": { "type": "string" }, "aliasChangedAfterOriginVerification": { "const": true }, "pinnedCli": { "type": "string", "pattern": "^wrangler@[0-9]+\\.[0-9]+\\.[0-9]+$" } } },
    "observations": { "type": "array", "minItems": 4, "items": { "type": "object", "additionalProperties": false, "required": ["at", "status", "evidenceId"], "properties": { "at": { "enum": ["+5m", "+1h", "+4h", "+24h"] }, "status": { "enum": ["pass", "fail"] }, "evidenceId": { "type": "string", "minLength": 1 } } } },
    "rollback": { "type": "object" },
    "observability": { "type": "object" },
    "approvals": { "type": "object" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "release": { "type": "object", "additionalProperties": false, "required": ["sha", "configFingerprint", "schemaVersion", "privacyProvenance", "exactReleaseMarker"], "properties": { "sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" }, "configFingerprint": { "$ref": "#/$defs/hash" }, "schemaVersion": { "type": "string", "minLength": 1 }, "privacyProvenance": { "type": "string", "minLength": 1 }, "exactReleaseMarker": { "type": "string", "minLength": 1 } } }
  }
}
